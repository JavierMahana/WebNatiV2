---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
    title: string;
    lang: Locale;
    description?: string;
    image?: string;
}

const {
    title,
    lang,
    description = 'Psicología y acompañamiento psicológico en español e inglés en Berlín y Online.',
    image = '/og-image.jpeg'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cleanPath = Astro.url.pathname.replace(/^\/(es|en)/, '') || '/';

// Construcción de URLs canónicas y de imagen para redes sociales
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://nataliamahana.com');
const imageURL = new URL(image, Astro.site || 'https://nataliamahana.com');
---

<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Redes Sociales / WhatsApp / LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google Fonts Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Hreflang y Favicon -->
    <link rel="alternate" hreflang="es" href={new URL(`${base}/es${cleanPath === '/' ? '/' : cleanPath}`, Astro.url)} />
    <link rel="alternate" hreflang="en" href={new URL(`${base}/en${cleanPath === '/' ? '/' : cleanPath}`, Astro.url)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/TempLogo.svg`} />
</head>
<body>
<Header currentLang={lang} />
<main>
    <slot />
</main>
<Footer currentLang={lang} />
</body>
</html>