---
// src/pages/en/servicios/ninos-adolescentes.astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import imgConsulta4 from '../../../assets/Consulta4.jpeg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
        title="Psychology for Children & Adolescents | Natalia Mahana Palomer"
        lang="en"
        description="Therapeutic support for children, adolescents, and youth in English and Spanish. Safe and affirming practice in Berlin and online."
>
    <div class="container seccion-detalle">

        <header class="header-detalle">
            <h1>Psychology for children and adolescents</h1>
            <p class="lead">A space to feel heard, understood, and build tools to navigate difficulties.</p>
        </header>

        <div class="grid-detalle">
            <div class="detalle-texto">
                <Image src={imgConsulta4} alt="Child and adolescent psychological consultation" class="banner-img" />

                <p>Sometimes children and adolescents find it difficult to express what they feel or understand what they are going through. These experiences can manifest through their emotions, shifts in their relationships, behavioral changes, or daily life challenges.</p>

                <p>I offer psychological sessions tailored to the age, characteristics, and needs of each young person. When appropriate, I also collaborate with mothers, fathers, and caregivers: the goal is never to place blame, but to gain a clearer understanding of the situation and co-create ways of support that make sense for the entire family.</p>

                <h3>Common situations where I can offer support:</h3>
                <ul class="lista-items">
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Emotional difficulties or challenges with emotional regulation.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Persistent anxiety, fears, and worries.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Times of transition (relocations, school adaptations, family changes).</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Behavioral difficulties or conflicts at school.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Peer relationships and social connection.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Self-esteem, body image, and identity.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Themes related to gender identity and sexuality.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Neurodivergence and different ways of experiencing the world.</span>
                    </li>
                    <li>
                        <svg class="item-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>Migration and intercultural adjustment processes.</span>
                    </li>
                </ul>

                <h3>In-Person Location in Berlin</h3>
                <p>In-person sessions at Spark: Markgrafendamm 20, Berlin.</p>
                <div class="mapa-wrapper">
                    <iframe
                            src="https://maps.google.com/maps?q=SPARK%20Collective,%20Markgrafendamm%2020,%20Berlin&t=&z=15&ie=UTF8&iwloc=&output=embed"
                            width="100%"
                            height="320"
                            style="border:0; border-radius: 12px;"
                            allowfullscreen=""
                            loading="lazy">
                    </iframe>
                </div>
            </div>

            <aside class="sidebar-precios">
                <div class="pricing-card">
                    <h3>Fees & Modalities</h3>
                    <p class="duracion-sesion">Session duration: 50 minutes</p>

                    <div class="precio-item">
                        <span class="modalidad">Child / Adolescent Session</span>
                        <span class="valor">120 €</span>
                    </div>

                    <p class="nota-social">Reduced-rate spots: Limited availability of sliding-scale spots upon prior inquiry.</p>

                    <hr />

                    <h4>Public Health Insurance</h4>
                    <p class="info-seguro">German statutory public health insurance does not directly cover my sessions. To find professionals covered by Krankenkasse, visit <a href="https://arztsuche.116117.de/" target="_blank" rel="noopener">KV Berlin (116117)</a>.</p>

                    <a href={`${base}/en/#contacto`} class="btn btn-primary" style="width: 100%; margin-top: 15px;">Inquire or book a session</a>
                </div>
            </aside>
        </div>

    </div>
</BaseLayout>

<style>
    .seccion-detalle { padding-top: 130px; padding-bottom: 90px; }
    .header-detalle { text-align: center; max-width: 800px; margin: 0 auto 50px; }
    .lead { font-size: 1.2rem; color: var(--text-light); margin-top: 10px; }
    .grid-detalle { display: grid; grid-template-columns: 1fr 380px; gap: 50px; align-items: start; }
    .banner-img { width: 100%; height: 320px; object-fit: cover; border-radius: var(--radius); margin-bottom: 30px; }
    .detalle-texto h3 { margin-top: 45px; margin-bottom: 18px; }
    .lista-items { list-style: none; padding: 0; margin: 20px 0 35px; }
    .lista-items li { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 12px; font-size: 1rem; color: var(--text-main); line-height: 1.55; }
    .item-icon { width: 18px; height: 18px; color: var(--primary-color); margin-top: 4px; flex-shrink: 0; }
    .sidebar-precios { position: sticky; top: 100px; }
    .pricing-card { background: var(--bg-alt); border: 1px solid var(--lavender-soft); padding: 30px; border-radius: var(--radius); box-shadow: var(--shadow); }
    .duracion-sesion { font-size: 0.95rem; color: var(--secondary-color); margin: 6px 0 16px; }
    .precio-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--lavender-soft); }
    .precio-item .valor { font-size: 1.5rem; font-weight: 700; color: var(--secondary-color); }
    .nota-social, .info-seguro { font-size: 0.88rem; color: var(--text-light); margin-top: 15px; line-height: 1.5; }
    .mapa-wrapper { margin-top: 20px; border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
    @media (max-width: 850px) { .grid-detalle { grid-template-columns: 1fr; } .sidebar-precios { position: static; } }
</style>