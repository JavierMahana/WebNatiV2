---
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
    currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);

const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(es|en)/, '') || '/';
---

<header class="site-header">
    <div class="container header-content">

        <!-- Logo -->
        <a href={`/${currentLang}/`} class="brand-logo">
            <span class="brand-name">Natalia Mahana</span>
            <span class="brand-sub">Psicóloga</span>
        </a>

        <!-- Navegación con ocultamiento progresivo -->
        <nav class="nav-links">
            <a href={`/${currentLang}/`} class="nav-item nav-tier-2">{t('nav.home')}</a>
            <a href={`/${currentLang}/about`} class="nav-item nav-tier-2">{t('nav.about')}</a>
            <a href={`/${currentLang}/#servicios`} class="nav-item nav-services">{t('nav.services')}</a>
            <a href={`/${currentLang}/#enfoque`} class="nav-item nav-tier-1">{t('nav.approach')}</a>
            <a href={`/${currentLang}/#faq`} class="nav-item nav-tier-1">{t('nav.faq')}</a>
            <a href={`/${currentLang}/#contacto`} class="nav-btn-contact nav-tier-3">{t('nav.contact')}</a>
        </nav>

        <!-- Selector de Idioma -->
        <div class="lang-switch">
            <a href={`/es${cleanPath === '/' ? '/' : cleanPath}`} class={currentLang === 'es' ? 'active' : ''}>ES</a>
            <span>|</span>
            <a href={`/en${cleanPath === '/' ? '/' : cleanPath}`} class={currentLang === 'en' ? 'active' : ''}>EN</a>
        </div>

    </div>
</header>

<style>
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        background-color: rgba(252, 251, 253, 0.95);
        backdrop-filter: blur(10px);
        z-index: 1000;
        border-bottom: 1px solid var(--lavender-soft);
    }

    .header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 20px;
        gap: 12px;
    }

    /* Logo */
    .brand-logo {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: transform 0.25s ease;
        flex-shrink: 0;
    }

    .brand-logo:hover {
        transform: translateY(-2px);
    }

    .brand-name {
        font-size: 1.44rem; /* +15% */
        font-weight: 700;
        color: var(--secondary-color);
        line-height: 1.15;
        transition: color 0.3s ease;
    }

    .brand-sub {
        font-size: 0.86rem; /* +15% */
        color: var(--text-light);
        letter-spacing: 1.1px;
        text-transform: uppercase;
        transition: color 0.3s ease;
    }

    .brand-logo:hover .brand-name {
        color: var(--primary-color);
    }

    .brand-logo:hover .brand-sub {
        color: var(--secondary-hover);
    }

    /* Enlaces de Navegación */
    .nav-links {
        display: flex;
        gap: 20px;
        align-items: center;
    }

    .nav-item {
        font-size: 1.06rem; /* +15% */
        font-weight: 500;
        color: var(--text-main);
        transition: color 0.3s ease, transform 0.2s ease;
    }

    .nav-item:hover {
        color: var(--primary-color);
        transform: translateY(-1px);
    }

    /* Enlace permanente de Servicios */
    .nav-services {
        font-weight: 600;
    }

    /* Botón de Contacto */
    .nav-btn-contact {
        background-color: var(--primary-color);
        color: var(--white) !important;
        font-size: 1.06rem; /* +15% */
        font-weight: 600;
        padding: 8px 20px;
        border-radius: 30px;
        box-shadow: 0 4px 14px rgba(93, 193, 185, 0.3);
        transition: all 0.3s ease;
    }

    .nav-btn-contact:hover {
        background-color: var(--primary-hover);
        transform: translateY(-3px);
        box-shadow: 0 6px 18px rgba(93, 193, 185, 0.45);
    }

    /* Selector de Idioma */
    .lang-switch {
        display: flex;
        gap: 6px;
        font-size: 0.98rem; /* +15% */
        font-weight: 600;
        align-items: center;
        flex-shrink: 0;
    }

    .lang-switch a {
        color: var(--text-light);
        transition: color 0.2s ease;
    }

    .lang-switch a:hover {
        color: var(--primary-color);
    }

    .lang-switch a.active {
        color: var(--secondary-color);
        text-decoration: underline;
        font-weight: 700;
    }

    /* ================= RESPONSIVE PROGRESIVO ================= */

    /* Nivel 1 (< 1040px): Oculta 'Mi Enfoque' y 'FAQ' */
    @media (max-width: 1040px) {
        .nav-tier-1 {
            display: none !important;
        }
    }

    /* Nivel 2 (< 780px): Oculta 'Inicio' y 'Sobre Mí' */
    @media (max-width: 780px) {
        .nav-tier-2 {
            display: none !important;
        }
    }

    /* Nivel 3 (< 520px): Oculta 'Contacto' (Queda SOLO 'Servicios' en el menú) */
    @media (max-width: 520px) {
        .nav-tier-3 {
            display: none !important;
        }
        .header-content {
            padding: 12px 16px;
        }
        .brand-name {
            font-size: 1.25rem;
        }
        .brand-sub {
            font-size: 0.75rem;
        }
    }

    /* Móviles ultra compactos (< 360px) */
    @media (max-width: 360px) {
        .brand-name {
            font-size: 1.1rem;
        }
        .nav-services {
            font-size: 0.95rem;
        }
        .lang-switch {
            font-size: 0.85rem;
        }
    }
</style>