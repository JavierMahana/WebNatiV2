---
// src/components/Footer.astro
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
    currentLang: Locale;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
    <div class="container grid-footer">
        <div class="footer-col">
            <h3>Natalia Mahana Palomer</h3>
            <p>{t('footer.description')}</p>
        </div>

        <div class="footer-col">
            <h4>{t('footer.nav')}</h4>
            <ul>
                <li><a href={`${base}/${currentLang}/`}>{t('nav.home')}</a></li>
                <li><a href={`${base}/${currentLang}/about`}>{t('nav.about')}</a></li>
                <li><a href={`${base}/${currentLang}/#servicios`}>{t('nav.services')}</a></li>
                <li><a href={`${base}/${currentLang}/#contacto`}>{t('nav.contact')}</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h4>{t('footer.contact')}</h4>
            <p>Spark Collective: Markgrafendamm 20, Berlín</p>
            <p>Email: <a href="mailto:n.mahanapalomer@proton.me">n.mahanapalomer@proton.me</a></p>
            <p>WhatsApp: +49 1522 5279914</p>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="container footer-bottom-flex">
            <p>&copy; {new Date().getFullYear()} Natalia Mahana Palomer. {t('footer.rights')}</p>
            <p class="disclaimer-text">{t('footer.disclaimer')}</p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: var(--bg-dark);
        color: var(--bg-alt);
        padding: 70px 0 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .grid-footer {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 40px;
        margin-bottom: 40px;
    }

    .footer h3 {
        color: var(--mint-soft);
        font-size: 1.4rem;
        margin-bottom: 12px;
    }

    .footer h4 {
        color: var(--white);
        font-size: 1.1rem;
        margin-bottom: 16px;
    }

    .footer p, .footer ul li {
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.8);
        margin-bottom: 10px;
        line-height: 1.5;
    }

    .footer a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .footer a:hover {
        color: var(--mint-soft);
    }

    .footer-bottom {
        padding-top: 25px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .footer-bottom-flex {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.6);
    }
</style>